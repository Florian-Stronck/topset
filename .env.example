# Copy to .env and adjust. Nothing here is needed for local development beyond DATABASE_URL.

# The SQLite file the app works on.
DATABASE_URL="file:./dev.db"

# --- Only for running the hosted server (see docs/cloud-setup.md) ---

# "athlete" serves only the athlete pages and the coach sign-in/sync API.
# TOPSET_ROLE="athlete"

# The server's database on Turso.
# TURSO_DATABASE_URL="libsql://topset-yourname.turso.io"
# TURSO_AUTH_TOKEN=""

# Invite code for the first (admin) account, and the admin's way back in. Keep it secret.
# TOPSET_ADMIN_SETUP_CODE=""

# --- Athlete videos, optional (see docs/cloud-setup.md, "Athlete videos") ---
# Any S3-compatible bucket; with Cloudflare R2, the account id is enough for the endpoint.
# TOPSET_R2_ACCOUNT_ID=
# TOPSET_VIDEO_ENDPOINT=
# TOPSET_VIDEO_BUCKET=
# TOPSET_VIDEO_ACCESS_KEY_ID=
# TOPSET_VIDEO_SECRET_ACCESS_KEY=
# Days a video is kept; match the bucket's lifecycle rule. Default 30.
# TOPSET_VIDEO_RETENTION_DAYS=

# --- Push notifications, optional (see docs/cloud-setup.md, "Notifications") ---
# Make a pair with `npx web-push generate-vapid-keys`. Without them the athlete app
# doesn't offer notifications.
# TOPSET_VAPID_PUBLIC_KEY=
# TOPSET_VAPID_PRIVATE_KEY=
# Who push services can contact about this server: mailto:you@example.com
# TOPSET_VAPID_SUBJECT=
# Lets Vercel Cron run the morning notifications (training days, meets).
# CRON_SECRET=
