generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Coach {
  id       String    @id @default(cuid())
  /// What the coach signs in with. Lowercase; Topset never sends mail, so it isn't an email.
  username String    @unique
  name     String
  /// Coach-wide preferences as JSON — see src/lib/settings.ts for the shape and defaults.
  settings String    @default("{}")
  /// Sign-in for the Topset server (the hosted app). Null for a coach who never signed up,
  /// and on every desktop copy — the server keeps these, sync never carries them.
  passwordHash String?
  isAdmin      Boolean  @default(false)
  /// Bumped on the server whenever this coach's athletes log something, so a desktop
  /// app can tell nothing changed without reading every set. Server-only, never synced.
  athleteVersion Int    @default(0)
  /// Set when the admin turns the account off: no sign-in, no sync, no athlete links.
  /// The data stays, and the admin can turn it back on. Server-only.
  disabledAt     DateTime?
  /// A one-time code from the admin for setting a new password, as a hash. Server-only.
  resetCodeHash  String?
  resetExpiresAt DateTime?
  athletes Athlete[]
  sessions CoachSession[]
  teams    TeamMember[]
}

/// A gym's coaches sharing a roster: every member sees and edits every athlete on the team.
/// Only the admin makes teams and picks their members. Kept on the server; a desktop app
/// holds a copy of the teams its coach is on, refreshed by sync and never sent back.
model Team {
  id       String       @id @default(cuid())
  name     String
  members  TeamMember[]
  athletes Athlete[]
}

model TeamMember {
  teamId  String
  coachId String
  team    Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  coach   Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([teamId, coachId])
  @@index([coachId])
}

/// A signed-in desktop app. Only a hash of its token is kept.
model CoachSession {
  id         String   @id @default(cuid())
  coachId    String
  coach      Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([coachId])
}

/// A one-time code the admin hands a new coach to create their account with.
model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  usedBy    String?
}

model Athlete {
  id       String  @id @default(cuid())
  coachId  String
  coach    Coach   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name     String
  unit     Unit    @default(KG)
  squat1RM Float?
  bench1RM Float?
  dead1RM  Float?
  /// The % of the competition max a variation is trained off; null uses the coach's default.
  variationPct  Float?
  /// Per-exercise drop-offs as JSON, {"Paused Squat": 85}; beats `variationPct`.
  variationPcts String?
  /// The coach's own notes on the athlete — goals, history; never shown to the athlete.
  notes         String?
  /// Secret for the athlete's check-in link. Null until the coach hands one out; a new one
  /// replaces the old, so a lost phone is one click away from locked out.
  accessToken String? @unique
  /// Secret for a read-only view of the athlete's Tracking, for a second coach.
  viewToken   String? @unique
  /// The team this athlete is shared with; null keeps them to `coachId`, who stays the
  /// owner either way. Set on the server only (see `PULLED_COLUMNS`).
  teamId   String?
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  blocks   Block[]
  programs Program[]
  meets    Meet[]
  bodyweights BodyweightLog[]
  questions   CheckinQuestion[]
  answers     CheckinAnswer[]
  messages    CoachMessage[]
  videos      AthleteVideo[]
  nutrition   NutritionLog[]
  photos      CheckinPhoto[]
  injuries    Injury[]
  moves       SessionMove[]
  meetings    Meeting[]

  @@index([coachId])
  @@index([teamId])
}

/// An injury, from the athlete app or the coach. Both sides write it, so it syncs like
/// weigh-ins: the newer edit wins, deletes are tombstones. `day` is when it started.
model Injury {
  id        String    @id @default(cuid())
  athleteId String
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// One of the areas in src/lib/injuries.ts.
  area      String
  /// "L", "R", or null for the middle of the body.
  side      String?
  /// `YYYY-MM-DD` it started, on the athlete's calendar.
  day       String
  /// `YYYY-MM-DD` it cleared up; null while it's still there.
  endDay    String?
  /// 1 (a niggle) to 5 (can't train it).
  severity  Int       @default(2)
  note      String?
  /// "athlete" or "coach": who entered it.
  source    String    @default("athlete")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([athleteId, day])
}

/// An athlete's plan. It is a name and an ordered list of phases — everything else
/// (dates, weeks, the grid, the 1RMs) belongs to the phase it was written for.
model Program {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  phases    Block[]

  @@index([athleteId])
}

model Meet {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  name        String
  federation  String?
  weightClass String?
  bodyweight  Float?
  date        DateTime
  createdAt   DateTime  @default(now())
  attempts    Attempt[]

  @@index([athleteId])
}

model Attempt {
  id     String        @id @default(cuid())
  meetId String
  meet   Meet          @relation(fields: [meetId], references: [id], onDelete: Cascade)
  lift   MeetLift
  number Int
  weight Float?
  result AttemptResult @default(PENDING)

  @@unique([meetId, lift, number])
}

/// One phase of a program: its own start date, week count, grid and maxes.
model Block {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  /// The phase's own name — "Base", "Peak". The program holds the plan's name.
  phase     String
  startDate DateTime

  // The maxes this block was written against. Seeded from the athlete when the block is
  // created, then frozen: a new PR must not silently rewrite a block already handed out.
  squat1RM  Float?
  bench1RM  Float?
  dead1RM   Float?
  // What the athlete eats to during this phase, per day; null where the coach sets none.
  // Grams for the macros.
  kcalTarget    Float?
  proteinTarget Float?
  carbsTarget   Float?
  fatTarget     Float?
  createdAt DateTime @default(now())
  weeks     Week[]

  @@index([athleteId])
  @@index([programId])
}

/// A week of a phase, with its own days. Weeks do not have to match each other: a week
/// owns its sessions outright, so one can drop an exercise, reorder, or rest a day
/// without touching the rest of the phase.
model Week {
  id      String @id @default(cuid())
  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  /// 1-based week number within the phase.
  order   Int
  /// A locked week keeps whatever is in it — progression rules skip over it when
  /// writing later weeks, so a manually-tuned deload doesn't get overwritten.
  locked  Boolean @default(false)
  days    Day[]

  @@unique([blockId, order])
}

model Day {
  id     String        @id @default(cuid())
  weekId String
  week   Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  index  Int
  label  String
  rest   Boolean       @default(false)
  /// When the coach last marked the session reviewed in Tracking. Coach-owned.
  reviewedAt DateTime?
  rows   ExerciseRow[]

  @@unique([weekId, index])
}

model ExerciseRow {
  id       String @id @default(cuid())
  dayId    String
  day      Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  order    Int
  tier     Tier   @default(ACCESSORY)
  target   String
  exercise String

  // What this row prescribes, for its own week. A row is one exercise on one day of one
  // week, so the prescription belongs on it rather than in a per-week side table.
  sets          Int?
  reps          Int?
  /// The top of a rep range ("8–10"); null for a single number. `reps` holds the bottom.
  repsMax       Int?
  intensityType IntensityType @default(RPE)
  intensity     Float?
  intensityMax  Float?
  rampStep      Float?
  /// The weight to use, typed over whatever the intensity works out to; null follows the
  /// intensity. Lets a row carry RPE 8 and 60 kg, or 60 s with 24 kg.
  load          Float?
  coachNotes    String?
  /// e.g. "3-1-X", free text.
  tempo         String?
  /// Rest between sets, free text ("2-3 min").
  restTime      String?
  videoUrl      String?
  /// Seconds per set — a round, an interval. Null for a row counted in reps alone.
  duration      Int?

  // What the athlete actually did.
  actualWeight Float?
  performedRpe Float?
  athleteNotes String?

  /// The same exercise in the week before. Progressions walk this chain forward, so a
  /// rule written once still drives the weeks that follow it.
  fromId String?      @unique
  from   ExerciseRow? @relation("WeekChain", fields: [fromId], references: [id], onDelete: SetNull)
  next   ExerciseRow? @relation("WeekChain")

  rules ProgressionRule[]
  /// Set by set, as the athlete checked them off in the athlete app.
  logs  SetLog[]

  @@unique([dayId, order])
}

/// One set the athlete logged against a row. Sets past the prescribed count are extras.
model SetLog {
  id       String      @id @default(cuid())
  rowId    String
  row      ExerciseRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  /// 0-based.
  setIndex Int
  weight   Float?
  reps     Int?
  rpe      Float?
  /// Reps in reserve, when the athlete logged effort that way. A set has an RPE or an RIR.
  rir      Float?
  /// How long the set took, for a timed row.
  seconds  Int?
  done     Boolean     @default(false)
  /// The athlete flagged this set as a personal record.
  pr       Boolean     @default(false)
  loggedAt DateTime    @updatedAt

  @@unique([rowId, setIndex])
  @@index([loggedAt])
}

/// A weigh-in, from the athlete app or typed in by the coach. Both sides write these, so
/// sync merges them row by row: the newer `updatedAt` wins, and a delete is a tombstone
/// (`deletedAt`) rather than a missing row, so it travels like any other edit.
model BodyweightLog {
  id        String    @id @default(cuid())
  athleteId String
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// The day it was weighed, `YYYY-MM-DD` on the athlete's calendar.
  day       String
  /// In the athlete's unit.
  weight    Float
  note      String?
  /// "athlete" or "coach": who entered it.
  source    String    @default("athlete")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([athleteId, day])
}

/// A day's eating, from the athlete app's check-in or typed in by the coach: totals, not
/// meals. One row per athlete and day, under the id `nutritionId` gives it, so both sides
/// write the same row and sync merges it like weigh-ins: the newer edit wins, deletes are
/// tombstones.
model NutritionLog {
  id        String    @id
  athleteId String
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// `YYYY-MM-DD` on the athlete's calendar.
  day       String
  kcal      Float?
  /// Grams.
  protein   Float?
  carbs     Float?
  fat       Float?
  /// "athlete" or "coach": who wrote it last.
  source    String    @default("athlete")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([athleteId, day])
}

/// A photo sent with a check-in answer, for a question the coach asked for one on. The file
/// lives in object storage beside the videos, and the coach's desktop app keeps a copy.
/// Only the athlete app writes these, so they only ever come down.
model CheckinPhoto {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// A plain id, so an archived or removed question leaves the photo.
  questionId  String
  /// The day the answer is filed under.
  day         String
  contentType String
  size        Int
  storageKey  String    @unique
  /// Set once the upload is in; until then the row is only a reservation.
  uploadedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([athleteId, day])
}

/// A question the athlete app asks, written by the coach for one athlete: what it asks,
/// how often, how it is answered, and the icon and colour it shows with. Coach-owned and
/// synced like the plan. A question with answers on file is archived rather than deleted,
/// so the answers keep their label.
model CheckinQuestion {
  id        String         @id @default(cuid())
  athleteId String
  athlete   Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  order     Int            @default(0)
  label     String
  cadence   CheckinCadence @default(DAILY)
  /// Weekdays, 0 = Monday, comma-separated. Daily: the days it is asked, empty = every
  /// day. Weekly: the first is the day it opens, and it stays open to the end of the week.
  days      String         @default("")
  kind      CheckinKind
  /// What the answer kind needs, as JSON — see src/lib/checkins.ts.
  config    String         @default("{}")
  icon      String         @default("check")
  color     String         @default("blue")
  archived  Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([athleteId])
}

/// One answer to a check-in question, for one day — for a weekly question, the day it
/// opened that week. The value is text whatever the kind (see src/lib/checkins.ts). Written
/// by the athlete app and synced like weigh-ins: the newer edit wins, deletes are tombstones.
model CheckinAnswer {
  id         String    @id @default(cuid())
  athleteId  String
  athlete    Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  questionId String
  /// `YYYY-MM-DD` on the athlete's calendar.
  day        String
  value      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([questionId, day])
  @@index([athleteId, day])
}

/// One message in the chat between coach and athlete: a note about a session, or anything
/// either of them wrote. Both sides write it — the sender the text, the other side when
/// they read it — so it syncs like weigh-ins: the newer edit wins, deletes are tombstones.
model CoachMessage {
  id        String    @id @default(cuid())
  athleteId String
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// Who wrote it: "coach" or "athlete".
  sender    String    @default("coach")
  /// The session it is about, or the day it was written, `YYYY-MM-DD` on the athlete's calendar.
  day       String
  /// The session's Day, when it still exists; a plain id so a deleted phase leaves the note.
  dayId     String?
  /// Set when the note is about one exercise of the session.
  rowId     String?
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([athleteId, day])
}

/// A session the athlete moved to another date from the athlete app. One per session, under
/// the id `moveId` gives it, so both sides write the same row: the athlete moves it (or back),
/// the coach marks it seen or puts it back. Synced like weigh-ins: the newer edit wins,
/// deletes are tombstones. The plan itself never changes; the calendar reads this on top.
model SessionMove {
  id        String    @id
  athleteId String
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// The session's Day.
  dayId     String
  /// `YYYY-MM-DD` the plan puts it on.
  fromDay   String
  /// `YYYY-MM-DD` it is done on instead.
  day       String
  reason    String?
  /// When the coach saw the move in Tracking; null while it's news.
  seenAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([athleteId, day])
}

/// A meeting between coach and athlete: a call, or a sit-down at the gym. Either side
/// proposes one; the other accepts or declines. Changing the time proposes it afresh, from
/// whoever changed it. Synced like weigh-ins: the newer edit wins, deletes are tombstones.
model Meeting {
  id         String    @id @default(cuid())
  athleteId  String
  athlete    Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// `YYYY-MM-DD`, with `time` as `HH:MM`: the wall clock both sides meet by.
  day        String
  time       String
  minutes    Int       @default(30)
  /// The IANA zone `day` and `time` are written in: the proposer's. Null when not known.
  timeZone   String?
  /// Where: an address, or a link to a video call.
  place      String?
  note       String?
  /// "athlete" or "coach": who proposed the time on file, and so who waits for an answer.
  proposedBy String
  /// PROPOSED, ACCEPTED, DECLINED or CANCELLED — see src/lib/meetings.ts.
  status     String    @default("PROPOSED")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([athleteId, day])
}

/// A video the athlete filmed of one exercise and sent from the athlete app. The file
/// itself is in object storage (see src/lib/storage.ts), never in the database: this row
/// is only where it is and what it's of. Storage deletes files after a few weeks; the
/// coach's desktop app downloads each one into its videos folder before then. Synced like
/// weigh-ins: the newer edit wins, deletes are tombstones.
model AthleteVideo {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// The exercise it is of; a plain id so a deleted phase leaves the video.
  rowId       String
  /// The session's day, `YYYY-MM-DD` on the athlete's calendar.
  day         String
  /// Which set of the exercise it shows, 0-based; null when the athlete didn't say.
  setIndex    Int?
  /// The file's name as it came off the phone, for the coach's copy.
  name        String
  contentType String
  /// In bytes, as uploaded.
  size        Int
  /// The object's key in the bucket.
  storageKey  String    @unique
  /// Set once the upload is in; until then the row is only a reservation.
  uploadedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([athleteId, day])
  @@index([rowId])
}

model ProgressionRule {
  id         String      @id @default(cuid())
  rowId      String
  row        ExerciseRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  order      Int
  field      ProgField
  op         ProgOp      @default(ADD)
  amount     Float
  everyWeeks Int         @default(1)
  startWeek  Int         @default(2)
  endWeek    Int?
  enabled    Boolean     @default(true)

  @@index([rowId])
}

enum Unit {
  KG
  LB
}

enum Tier {
  PRIMARY
  SECONDARY
  VARIATION
  BACKOFF
  ACCESSORY
}

enum ProgField {
  SETS
  REPS
  INTENSITY
  DURATION
  /// The typed weight (`load`), or a weight intensity when there is none.
  LOAD
}

enum ProgOp {
  ADD
  MULTIPLY
}

enum MeetLift {
  SQUAT
  BENCH
  DEADLIFT
}

enum AttemptResult {
  PENDING
  GOOD
  MISS
}

enum CheckinCadence {
  DAILY
  WEEKLY
}

enum CheckinKind {
  NUMBER
  SCALE
  SINGLE
  MULTI
  YESNO
  TEXT
}

enum IntensityType {
  RPE
  RIR
  PERCENT
  WEIGHT
  RANGE
  BACKOFF
}

/// A phone that asked for push notifications from the athlete app, and which kinds it
/// wants. Lives on the server alone (never synced). `token` is the check-in link it signed
/// up with: a new link turns the old phone's notifications off with it.
model PushSubscription {
  id        String   @id @default(cuid())
  athleteId String
  token     String
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// The phone's time zone, for "training today" on the athlete's own calendar.
  timeZone  String?
  /// A note from the coach.
  notes     Boolean  @default(true)
  /// The coach changed the plan.
  plan      Boolean  @default(true)
  /// Morning of a training day.
  reminder  Boolean  @default(true)
  /// A week and a day before a competition.
  meets     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([athleteId])
}

/// The coach changed an athlete's plan and the athlete hasn't been told yet. Sent once the
/// coach has stopped editing for a few minutes, so one evening of work is one notification.
/// Server-side only.
model PlanNotice {
  athleteId String    @id
  coachId   String
  /// The last change not yet told; null when there is none.
  changedAt DateTime?
  sentAt    DateTime?

  @@index([coachId])
}

/// Sign-in tries against one username (or the setup code) since the last success. Ten
/// wrong ones lock it until 15 minutes have passed without a try. Server-side only.
model LoginAttempt {
  key    String   @id
  tries  Int      @default(0)
  lastAt DateTime
}

/// A plan row a desktop app pushed, in order, so the coach's other computers can pull what
/// changed since they last looked. `sessionId` is the computer that pushed it, which never
/// needs its own changes back. Server-side only.
model PlanChange {
  rev       Int      @id @default(autoincrement())
  coachId   String
  table     String
  rowId     String
  sessionId String?
  /// The athlete the row belongs to, so teammates get each other's edits. Null for a
  /// coach's own profile, and for entries from before teams.
  athleteId String?
  at        DateTime @default(now())

  @@index([coachId, rev])
  @@index([athleteId, rev])
}

/// What this desktop app last sent up, per row, as a digest of the coach's columns: so a
/// restart knows what changed or was deleted here without asking the server. Desktop only.
model SyncSent {
  table String
  id    String
  sig   String

  @@id([table, id])
}

/// Desktop-side sync bookmarks, such as how far into the server's PlanChange log this copy
/// has read. Desktop only.
model SyncMeta {
  key   String @id
  value String
}
